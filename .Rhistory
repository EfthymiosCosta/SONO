# Need this to compute ratio in critical points
source('mcd_fun.R')
# Choose balanced, mildly unbalanced or unbalanced
balance_opts <- c("balanced", "mildunb", "unb")
path <- "MCDmix_Sims/BinaryDummies/binary_dummies_res_df_"
### Balanced Case
balance <- balance_opts[1]
mean_ratios <- c()
for (i in c(1, 4:10)){
test <- readRDS(paste0(path, balance, "_", i, ".RDS"))
mean_ratios <- c(mean_ratios, sapply(test, function(x) x[[10]][[4]]))
dfs_original <- sapply(test, function(x) x[[4]])
dfs_new <- sapply(test, function(x) x[[4]] + x[[3]])
original_crits <- sapply(dfs_original,
FUN = function(x) outlier_detect_critical_val(alpha = 0.01,
n = 500,
dfs = x))
new_crits <- sapply(dfs_new,
FUN = function(x) outlier_detect_critical_val(alpha = 0.01,
n = 500,
dfs = x))
}
quantile_ratios <- new_crits/original_crits
hist(mean_ratios - quantile_ratios, breaks = 50)
summary(mean_ratios - quantile_ratios)
### Mildly Unbalanced Case
balance <- balance_opts[2]
mean_ratios <- c()
for (i in c(1:10)){
test <- readRDS(paste0(path, balance, "_", i, ".RDS"))
mean_ratios <- c(mean_ratios, sapply(test, function(x) x[[10]][[4]]))
dfs_original <- sapply(test, function(x) x[[4]])
dfs_new <- sapply(test, function(x) x[[4]] + x[[3]])
original_crits <- sapply(dfs_original,
FUN = function(x) outlier_detect_critical_val(alpha = 0.01,
n = 500,
dfs = x))
new_crits <- sapply(dfs_new,
FUN = function(x) outlier_detect_critical_val(alpha = 0.01,
n = 500,
dfs = x))
}
quantile_ratios <- new_crits/original_crits
hist(mean_ratios - quantile_ratios, breaks = 50)
summary(mean_ratios - quantile_ratios)
dev,off()
dev.off()
