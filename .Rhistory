sono_out
vis_contribs(contribs_mat = sono_out[[3]], subset = c(1:100), scale = "row")
sono_out[[3]]
contribs_mat = sono_out[[3]]
subset <- c(1:50)
scale <- "row"
if (!is.data.frame(contribs_mat)){
stop("Matrix of contributions should be of class 'data.frame'.")
}
if (any(contribs_mat < 0)){
stop("Matrix of contributions can only have non-negative values.")
}
if (max(subset) > nrow(contribs_mat)){
stop("Invalid subset.")
}
if (!scale %in% c("row", "max", "none")){
stop("Scaling can only be one of 'row', 'max' or 'none'.")
}
if (!is.null(subset)){
contribs_mat <- contribs_mat[subset, ]
}
contribs_mat
if (scale == "row"){
excl_rows <- which(rowSums(contribs_mat) == 0)
if (length(excl_rows) > 0){
contribs_mat[-excl_rows, ] <- contribs_mat[-excl_rows, ]/(rowSums(contribs_mat)[-excl_rows])
}
} else if (scale == "max"){
contribs_mat <- contribs_mat/max(contribs_mat)
}
contribs_mat
contribs_mat_f <- reshape2::melt(contribs_mat)
colnames(contribs_mat_f) <- c("Row", "Column", "Value")
contribs_mat_f <- reshape2::melt(contribs_mat)
contribs_mat_f
colnames(contribs_mat_f) <- c("Column", "Value")
contribs_mat_f <- reshape2::melt(contribs_mat)
contribs_mat_f
if (ncol(contribs_mat_f) == 2){
contribs_mat_f <- cbind(subset, contribs_mat_f)
}
contribs_mat_f
colnames(contribs_mat_f) <- c("Row", "Column", "Value")
contribs_mat_f
contribs_mat_f$Row <- factor(
contribs_mat_f$Row,
levels = unique(contribs_mat_f$Row)
)
plt_contribmat <- ggplot2::ggplot(contribs_mat_f, aes(x = Column, y = as.factor(Row), fill = Value)) +
ggplot2::geom_tile() +
ggplot2::scale_fill_viridis_c(option = "magma") +
ggplot2::labs(title = "Contribution Matrix Plot", x = "Variable", y = "Observation", fill = "Contribution") +
ggplot2::theme_bw() +
ggplot2::theme(axis.text.x = element_text(angle = 30, hjust = 1), axis.text.y = element_blank(),
axis.ticks.y = element_blank())
plt_contribmat <- ggplot2::ggplot(contribs_mat_f, ggplot2::aes(
x = .data$Column,
y = as.factor(.data$Row),
fill = .data$Value)) +
ggplot2::geom_tile() +
ggplot2::scale_fill_viridis_c(option = "magma") +
ggplot2::labs(title = "Contribution Matrix Plot",
x = "Variable",
y = "Observation",
fill = "Contribution") +
ggplot2::theme_bw() +
ggplot2::theme(axis.text.x = ggplot2::element_text(angle = 30, hjust = 1),
axis.text.y = ggplot2::element_blank(),
axis.ticks.y = ggplot2::element_blank())
return(plt_contribmat)
plt_contribmat
