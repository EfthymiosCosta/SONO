frequent = FALSE,
verbose = TRUE)
# See summary of scores
summary(sono_res2[[2]][, 2])
sono_res2$Depth
# See summary of scores for each case
summary(sono_res2[[2]][which(data[, 1] == 1), 2])
# See summary of scores for each case
summary(sono_res2[[2]][which(X[, 1] == 1), 2])
summary(sono_res2[[2]][which(X[, 1] == 2), 2])
summary(sono_res2[[2]][which(X[, 2] == 1), 2])
which(sono_res2[[2]][, 2] > 0)
# Plot matrix of contributions
SONO::vis_contribs(contribs_mat = sono_res2[[3]],
subset = which(sono_res2[[2]][, 2] > 0),
scale = "max")
# Plot matrix of contributions
SONO::vis_contribs(contribs_mat = sono_res2[[3]],
subset = which(sono_res2[[2]][, 2] > 0),
scale = "max")
outliers <- which(X[, 2] == 1)
# Plot matrix of contributions
avg_rank_outs(scores = sono_res2[[2]][, 2],
outs = outliers,
ties = "min")
outliers <- which(X[, 2] == 1)
# Compute average rank of outliers
avg_rank_outs(scores = sono_res2[[2]][, 2],
outs = outliers,
ties = "min")
recall_at_k(scores = sono_res2[[2]][, 2],
outs = outliers,
grid = c(1, 2.5, seq(5, 100, by = 5))/100)
outliers <- which(X[, 2] == 1)
# Compute average rank of outliers
avg_rank_outs(scores = sono_res2[[2]][, 2],
outs = outliers,
ties = "min")
recall_at_k(scores = sono_res2[[2]][, 2],
outs = outliers,
grid = c(1, 2.5, seq(5, 100, by = 5))/100)
roc_auc(scores = sono_res2[[2]][, 2],
outs = outliers,
grid = c(1, 2.5, seq(5, 100, by = 5))/100))
outliers <- which(X[, 2] == 1)
# Compute average rank of outliers
avg_rank_outs(scores = sono_res2[[2]][, 2],
outs = outliers,
ties = "min")
recall_at_k(scores = sono_res2[[2]][, 2],
