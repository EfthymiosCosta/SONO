# Function to generate a scrambled letter sequence with spaces
generate_scrambled_letters <- function(num_letters = 50) {
# Generate random uppercase letters
letters_sample <- sample(LETTERS, num_letters, replace = TRUE)
# Join the letters with spaces in between
scrambled_letters <- paste(letters_sample, collapse = " ")
return(scrambled_letters)
}
# Generate 50 scrambled letters with spaces
scrambled_sequence <- generate_scrambled_letters(50)
cat(scrambled_sequence)
# Generate 50 scrambled letters with spaces
scrambled_sequence <- generate_scrambled_letters(500)
cat(scrambled_sequence)
# Generate 50 scrambled letters with spaces
scrambled_sequence <- generate_scrambled_letters(100)
cat(scrambled_sequence)
